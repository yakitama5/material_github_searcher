# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Agent plans are temporary worktree files and are not committed.
# Keep the directory itself in the repository.
/plans/*
!/plans/.gitkeep

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
**/coverage/
**/test_bundle.dart
.patrol.env

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
**/android/app/debug
**/android/app/profile
**/android/app/release

# Desktop runners are intentionally not part of this app (Android/iOS only).
# `flutter build`/`pub get` can still regenerate plugin registration files here
# from `.metadata`; ignore them so they are never committed again.
apps/app/macos/
apps/app/linux/
apps/app/windows/
