// https://github.com/DavidAnson/markdownlint-cli2?tab=readme-ov-file#markdownlint-cli2jsonc
{
  // https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    "MD013": false, // 日本語ドキュメントは1行が80文字を超えやすいため無効化
    "MD033": false, // 色付けや改行などで inline HTML を意図的に使いたいケースがあるため無効化
    "MD045": false, // 開発者向けドキュメントにAlt必須を求めるのは過剰なため無効化
    "MD024": {
      // 異なる親見出し配下であれば同名の子見出し（「なぜその決定に至ったか」等）を
      // 繰り返せるようにする。docs/technical-decisions.mdが節ごとに同じ小見出しを
      // 繰り返す構成のため。
      "siblings_only": true
    }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    ".idea/**/*.md",
    "**/.dart_tool/**/*.md",
    "**/build/**/*.md",
    "**/node_modules/**/*.md",
    "**/ios/Pods/**/*.md",
    "**/ios/.symlinks/**/*.md",
    // ios/Runner配下はFlutterが生成するボイラープレートのため対象外
    "**/ios/Runner/**/*.md",
    // .claude, .codex, CLAUDE.md は .agents/AGENTS.md へのシンボリックリンクのため
    // 実体と二重に検査しないよう対象外にする
    ".claude/**/*.md",
    ".codex/**/*.md",
    "CLAUDE.md",
    // .serena はエージェント支援ツールSerenaのプロジェクト資産であり、本プロジェクトの
    // 成果物ではないため対象外にする
    ".serena/**/*.md"
  ]
}
